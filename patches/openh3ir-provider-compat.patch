+def _unsupported_optional_fields(status: int, response_text: str,
+                                 body: dict[str, Any]) -> tuple[str, ...]:
+    """Return optional top-level fields the provider explicitly says it cannot accept.
+
+    This is intentionally provider-neutral. There is no hostname or model-name switch: the
+    refusal itself is the capability signal. A field is removable only when it is both on the
+    small audited allowlist above and named by an ordinary unsupported/unknown-field diagnostic.
+    Ambiguous errors, auth failures and required-field failures pass through unchanged.
+    """
+    if status not in COMPAT_REFUSAL_STATUSES or not response_text:
+        return ()
+    text = _server_sentence(response_text)
+    found: list[str] = []
+    for field in sorted(COMPAT_OPTIONAL_FIELDS.intersection(body)):
+        quoted = re.escape(field)
+        patterns = (
+            rf"unknown\s+(?:name|field|parameter|argument)[^\n]{{0,80}}[\"']?{quoted}[\"']?",
+            rf"unrecognized\s+(?:request\s+)?(?:field|parameter|argument)[^\n]{{0,80}}[\"']?{quoted}[\"']?",
+            rf"[\"']?{quoted}[\"']?[^\n]{{0,80}}(?:is\s+)?(?:not\s+supported|not\s+permitted|extra_forbidden)",
+        )
+        if any(re.search(pattern, text, flags=re.IGNORECASE) for pattern in patterns):
+            found.append(field)
+    return tuple(found)
+
